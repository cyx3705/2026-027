{
  "schemaVersion": 1,
  "template": {
    "isTemplate": false,
    "source": "0000-001-AIReady",
    "strictValidationArgument": "-Instantiation"
  },
  "project": {
    "id": "2026-027",
    "name": "HistoryPortunus",
    "title": "HistoryPortunus 对外传输",
    "kind": [
      "software",
      "tooling",
      "transport-module"
    ],
    "status": "active",
    "version": "1.2.0",
    "branch": "main"
  },
  "paths": {
    "activeRoots": [
      "b-Code-Portunus",
      "b-Code-Verify",
      "b-Office"
    ],
    "sourceRoots": [
      "b-Code-Portunus",
      "b-Code-Verify"
    ],
    "generatedRoots": [
      "b-Code-Portunus/**/bin",
      "b-Code-Portunus/**/obj",
      "b-Code-Verify/**/bin",
      "b-Code-Verify/**/obj",
      "z-Publish"
    ],
    "archiveRoots": [
      "z-Publish/history"
    ],
    "releaseRoots": [
      "z-Publish"
    ],
    "allowedRootDirectoryPrefixes": [
      "a-",
      "b-",
      "z-"
    ]
  },
  "documents": {
    "conventions": "b-Office/现行约定.md"
  },
  "commands": {
    "setup": "dotnet restore .\\HistoryPortunus.sln --locked-mode -p:NuGetAudit=false",
    "build": "dotnet build .\\HistoryPortunus.sln -c Release --no-restore -p:NuGetAudit=false",
    "test": "dotnet test .\\b-Code-Verify\\Contracts\\Contracts.csproj -c Release -p:NuGetAudit=false",
    "verify": "dotnet test .\\b-Code-Verify\\Contracts\\Contracts.csproj -c Release --no-build --no-restore -p:NuGetAudit=false",
    "run": null,
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\b-Code-Portunus\\eng\\Build-HistoryPortunusPackage.ps1"
  },
  "externalDependencies": [
    "HistoryVulcan >= 6.0.0 published host snapshot",
    ".NET 8 SDK"
  ],
  "contextExclusions": [
    "z-Publish/**",
    "**/bin/**",
    "**/obj/**",
    "**/node_modules/**",
    "**/.vs/**",
    "artifacts/**"
  ],
  "publish": {
    "versionProps": "b-Code-Portunus\\PortunusVersion.props",
    "versionProperty": "HistoryPortunusVersion",
    "sourceManifest": "b-Code-Portunus\\module.manifest.json",
    "package": {
      "project": "b-Code-Portunus\\HistoryPortunus.csproj",
      "files": [
        "HistoryPortunus.dll",
        "HistoryPortunus.xml",
        "module.manifest.json"
      ]
    },
    "validation": [
      {
        "tool": "dotnet.exe",
        "configurations": [
          "Release"
        ],
        "arguments": [
          "test",
          "b-Code-Verify\\Contracts\\Contracts.csproj",
          "-c",
          "{configuration}",
          "-p:NuGetAudit=false"
        ],
        "description": "Run Portunus contract tests"
      }
    ]
  }
}
