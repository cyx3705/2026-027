<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="PortunusVersion.props" />

  <PropertyGroup>
    <!--
      net8.0 而不是 net8.0-windows：本模块只有 HttpListener 与 JSON，没有任何
      WPF 或 Win32 依赖。这也是它比前端类模块更值得搬出宿主的地方——
      纯托管、无原生锁，装载上下文能真正卸载，改它不必停服。
    -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HistoryPortunus</AssemblyName>
    <RootNamespace>HistoryPortunus</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573;CS1591</NoWarn>
    <HistoryVulcanPackageRoot Condition="'$(HistoryVulcanPackageRoot)' == ''">$(MSBuildThisFileDirectory)..\..\2026-023-HistoryVulcan\z-Publish</HistoryVulcanPackageRoot>
    <HistoryVulcanHostRoot Condition="'$(HistoryVulcanHostRoot)' == ''">$(HistoryVulcanPackageRoot)\host</HistoryVulcanHostRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- 模块引用宿主运行库一律 Private=false：部署时由宿主提供，包里不带副本。 -->
    <Reference Include="HistoryVulcan.Core">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HistoryVulcan.Extensibility">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Extensibility.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HistoryVulcan.Services">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Services.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="module.manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Contracts" />
  </ItemGroup>
</Project>
